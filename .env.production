DOTENV_PUBLIC_KEY_PRODUCTION="x25519-public:MCowBQYDK2VuAyEAbOaCBnbWCyEzP-AVV6-9XjC7IDt_TJlMzYrlWxciEzA"

# Secrets for the production environment.
#
# Values here are encrypted with the public key below and decrypted at
# deploy time with the matching private key in .env.keys, which is NOT
# committed. This file is - that is the point: the ciphertext is reviewable
# and diffable, and losing a laptop does not leak production.
#
# Add one with:
#   buddy env:set STRIPE_SECRET_KEY sk_live_… --env production
#
# Left empty on purpose. Nothing was copied out of your .env: that file
# describes a laptop, and a server is not one.

# DNS: the zone moves to Cloudflare, the domain stays registered at Porkbun
# (config/cloud.ts infrastructure.dns).
CLOUDFLARE_API_TOKEN="encrypted:v2:"
CLOUDFLARE_ACCOUNT_ID="encrypted:v2:eyJ2IjoyLCJlcGsiOiJNQ293QlFZREsyVnVBeUVBN0J5Ymc3SjQ5NllPSF9RTnNBQnZfdkxLVlZxNzRmeHU2eVF3TVFRRGFENCIsInNhbHQiOiIybHJPdUI4b0Y4eXFzdjFjM2RicFlBIiwibm9uY2UiOiJ5cnBGZmo4eXhHalR1cmZ5IiwiY2lwaGVydGV4dCI6IkRlSEliQ3hubnpnRTJIRHdFRl9HR3lMZFRGZ2pERWU5UDBMT2UydkhLMUkiLCJ0YWciOiJuUjd3b1pLbVl5SDBnNVloc2g1TFlBIn0"
