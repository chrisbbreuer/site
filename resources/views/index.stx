<script server>
const fs = require('node:fs')
const path = require('node:path')
const { readingStats } = require(path.join(process.cwd(), 'resources/utils/reading-stats.ts'))
const { longPostDate } = require(path.join(process.cwd(), 'resources/utils/post-date.ts'))
const { homeEvents } = require(path.join(process.cwd(), 'resources/utils/events.ts'))

const title = 'Chris Breuer - Software engineer, founder & ultra skyrunner'
const description = 'Chris Breuer builds developer and agentic tooling, plus the apps on top of it: Stacks, HQ.training, Wildloop. Skyrunner. Notes on both.'
const activeNav = ''
const pagePath = '/'

// Coming up and recently: runs, races and trips, from content/events.json.
// Split by date on every render, so a finished one moves down by itself.
const { upcoming, recent } = homeEvents()

// Read post frontmatter straight from content/blog (same source /blog renders).
const blogDir = path.join(process.cwd(), 'content/blog')
const posts = fs.readdirSync(blogDir)
  .filter(f => f.endsWith('.md'))
  .map((f) => {
    const raw = fs.readFileSync(path.join(blogDir, f), 'utf-8')
    const match = raw.match(/^---\n([\s\S]*?)\n---/)
    const fm = {}
    if (match) {
      for (const line of match[1].split('\n')) {
        const i = line.indexOf(':')
        if (i === -1)
          continue
        let val = line.slice(i + 1).trim()
        if ((val.startsWith('"') && val.endsWith('"')) || (val.startsWith('\'') && val.endsWith('\'')))
          val = val.slice(1, -1)
        fm[line.slice(0, i).trim()] = val
      }
    }
    return { slug: f.replace(/\.md$/, ''), title: fm.title, date: fm.date, longDate: fm.date ? longPostDate(fm.date) : '', stats: readingStats(raw).label }
  })
  .filter(p => p.title && p.date)
  .sort((a, b) => b.date.localeCompare(a.date))
</script>

@layout('layouts/site')

@push('head')
  <link rel="alternate" type="application/rss+xml" title="Chris Breuer" href="/blog/feed.xml">
@endpush

@section('content')
  <h1 class="page-title">Software engineer, <br class="title-break">founder, ultra skyrunner.</h1>
  <p class="page-lead">
    And a big dog person... Anyways, I build developer tooling. <a href="https://stacksjs.com">Stacks</a>, a TypeScript
    framework and the ecosystem around it, and increasingly agentic tooling: the things
    engineers reach for, and the things their agents reach for. Plus the apps that run on top
    of all of it. All of it aims to be as fast and as energy efficient as software can be:
    in the age of AI, well-built abstractions are one way to scale AI sustainably.
    The other half of my life is spent skyrunning: long days in the mountains, usually with Mo (Kengal)
    somewhere ahead of me on the trail. The two halves keep pointing at each other. This is where
    I write about both.
  </p>

  <h2 class="section-label">Building</h2>
  <ul class="entry-list">
    <li>
      <span class="entry-name"><a href="https://stacksjs.com">Stacks</a></span>
      <span class="entry-desc">A TypeScript framework, and the open-source ecosystem that grew around it.</span>
    </li>
    <li>
      <span class="entry-name"><a href="https://hq.training">HQ.training</a></span>
      <span class="entry-desc">An operating system for gyms, coaches and athletes: memberships, scheduling and billing, sitting next to the training data.</span>
    </li>
    <li>
      <span class="entry-name"><a href="https://wildloop.org">Wildloop</a></span>
      <span class="entry-desc">Trail discovery and GPS recording, with a territory game underneath: close a loop and the ground inside it is yours.</span>
    </li>
  </ul>

  @if (upcoming.length > 0)
    <h2 class="section-label">Coming up</h2>
    <ul class="entry-list">
      @foreach (upcoming as event)
        <li>
          <span class="entry-name">@if (event.url)<a href="{{ event.url }}">{{ event.title }}</a>@else{{ event.title }}@endif</span>
          <span class="entry-desc">@if (event.place){{ event.place }}. @endif{{ event.detail }} <span class="entry-meta">{{ event.whenLabel }}</span></span>
        </li>
      @endforeach
    </ul>
  @endif

  @if (recent.length > 0)
    <h2 class="section-label">Recently</h2>
    <ul class="entry-list">
      @foreach (recent as event)
        <li>
          <span class="entry-name">@if (event.url)<a href="{{ event.url }}">{{ event.title }}</a>@else{{ event.title }}@endif</span>
          <span class="entry-desc">@if (event.place){{ event.place }}. @endif{{ event.detail }} <span class="entry-meta">{{ event.whenLabel }}</span></span>
        </li>
      @endforeach
    </ul>
  @endif

  <h2 class="section-label">Writing</h2>
  @if (posts.length > 0)
    <ul class="post-list">
      @foreach (posts as post)
        <li>
          <a href="/blog/{{ post.slug }}">
            <span class="post-main">
              <span class="post-title">{{ post.title }}</span>
              <span class="post-stats">{{ post.stats }}</span>
            </span>
            <time class="post-date" datetime="{{ post.date }}">{{ post.longDate }}</time>
          </a>
        </li>
      @endforeach
    </ul>
  @else
    <p class="empty-note">
      Nothing published yet. The first post is in the works; subscribe below
      and it lands in your inbox the moment it ships.
    </p>
  @endif

  @include('../partials/subscribe.stx')
@endsection
