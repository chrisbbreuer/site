<script server>
const fs = require('node:fs')
const path = require('node:path')

const title = 'Chris Breuer - Software engineer, founder & skyrunner'
const description = 'Chris Breuer builds developer and agentic tooling — Stacks, HQ.training, Wildloop — and skyruns long days in the mountains. Notes on both.'
const activeNav = ''
const pagePath = '/'

// Read post frontmatter straight from content/blog (same source /blog renders).
const blogDir = path.join(process.cwd(), 'content/blog')
const posts = fs.readdirSync(blogDir)
  .filter(f => f.endsWith('.md'))
  .map((f) => {
    const raw = fs.readFileSync(path.join(blogDir, f), 'utf-8')
    const match = raw.match(/^---\n([\s\S]*?)\n---/)
    const fm = {}
    if (match) {
      for (const line of match[1].split('\n')) {
        const i = line.indexOf(':')
        if (i === -1)
          continue
        let val = line.slice(i + 1).trim()
        if ((val.startsWith('"') && val.endsWith('"')) || (val.startsWith('\'') && val.endsWith('\'')))
          val = val.slice(1, -1)
        fm[line.slice(0, i).trim()] = val
      }
    }
    return { slug: f.replace(/\.md$/, ''), title: fm.title, date: fm.date }
  })
  .filter(p => p.title && p.date)
  .sort((a, b) => b.date.localeCompare(a.date))
  .map(p => ({ ...p, shortDate: p.date.slice(0, 7) }))
</script>

@layout('layouts/site')

@push('head')
  <link rel="alternate" type="application/rss+xml" title="Chris Breuer" href="/blog/feed.xml">
@endpush

@section('content')
  <h1 class="page-title">Software engineer,<br class="title-break">founder, skyrunner.</h1>
  <p class="page-lead">
    I build developer tooling &mdash; <a href="https://stacksjs.com">Stacks</a>, a TypeScript
    framework and the ecosystem around it &mdash; and increasingly agentic tooling: the things
    engineers reach for, and the things their agents reach for. Plus the apps that run on top
    of all of it.
    The other half of my life is spent skyrunning: long days in the mountains, usually with a dog
    somewhere ahead of me on the trail. The two halves keep pointing at each other. This is where
    I write about both.
  </p>

  <h2 class="section-label">Building</h2>
  <ul class="entry-list">
    <li>
      <span class="entry-name"><a href="https://stacksjs.com">Stacks</a></span>
      <span class="entry-desc">A TypeScript framework &mdash; and the open-source ecosystem that grew around it.</span>
    </li>
    <li>
      <span class="entry-name"><a href="https://hq.training">HQ.training</a></span>
      <span class="entry-desc">An operating system for gyms, coaches and athletes &mdash; memberships, scheduling and billing, sitting next to the training data.</span>
    </li>
    <li>
      <span class="entry-name"><a href="https://wildloop.org">Wildloop</a></span>
      <span class="entry-desc">Trail discovery, GPS recording and a social feed, with a territory game underneath: close a loop and you claim what it encircles.</span>
    </li>
  </ul>

  <h2 class="section-label">Writing</h2>
  @if (posts.length > 0)
    <ul class="post-list">
      @foreach (posts as post)
        <li>
          <a href="/blog/{{ post.slug }}">
            <span class="post-title">{{ post.title }}</span>
            <span class="post-date">{{ post.shortDate }}</span>
          </a>
        </li>
      @endforeach
    </ul>
  @else
    <p class="empty-note">
      Nothing published yet. The first post is in the works; subscribe below
      and it lands in your inbox the moment it ships.
    </p>
  @endif

  @include('../partials/subscribe.stx')
@endsection

@push('scripts')
  <script src="{{ asset('/assets/scripts/subscribe.js') }}" defer></script>
@endpush
