<script server>
const path = require('node:path')
const { blogPosts } = require(path.join(process.cwd(), 'resources/utils/blog-posts.ts'))
const { homeEvents } = require(path.join(process.cwd(), 'resources/utils/events.ts'))

const title = 'Chris Breuer - Software engineer, founder & ultra runner'
const description = 'Chris Breuer builds developer and agentic tooling, plus the apps on top of it: Stacks, HQ.training, Wildloop. ultra runner and dog person. Notes on both.'
const activeNav = ''
const pagePath = '/'

// Coming up and recently: runs, races and trips, from content/events.json.
// Split by date on every render, so a finished one moves down by itself.
const { upcoming, recent } = homeEvents()

const posts = blogPosts()
</script>

@layout('layouts/site')

@push('head')
  <link rel="alternate" type="application/rss+xml" title="Chris Breuer" href="/blog/feed.xml">
@endpush

@section('content')
  <h1 class="page-title">Software engineer, <br class="title-break">founder, ultra runner.</h1>
  <p class="page-lead home-lead">I build open-source developer tools and write about software, skyrunning, and life with Mo, my Kangal.</p>
  <div class="home-links">
    <a href="/blog">Read the blog <span aria-hidden="true">→</span></a>
    <a href="/projects">Explore the projects <span aria-hidden="true">→</span></a>
  </div>

  <h2 class="section-label">Building</h2>
  <ul class="entry-list">
    <li>
      <span class="entry-name"><a href="/stacks">Stacks</a></span>
      <span class="entry-desc">A full-stack TypeScript framework on Bun, and the open-source tools behind it.</span>
    </li>
    <li>
      <span class="entry-name"><a href="/home">Home</a></span>
      <span class="entry-desc">A language for JavaScript and TypeScript, with the runtime of Node and Bun built in and a drop-in tsc that type-checks your project many times faster.</span>
    </li>
    <li>
      <span class="entry-name"><a href="https://hq.training">HQ.training</a></span>
      <span class="entry-desc">Memberships, scheduling and billing for gyms and coaches, alongside athletes' training data.</span>
    </li>
    <li>
      <span class="entry-name"><a href="https://wildloop.org">Wildloop</a></span>
      <span class="entry-desc">Trail discovery and GPS recording, with a territory game: close a loop to claim the ground inside it.</span>
    </li>
  </ul>

  @if (upcoming.length > 0)
    <h2 class="section-label">Coming up</h2>
    <ul class="entry-list">
      @foreach (upcoming as event)
        <li>
          <span class="entry-name">@if (event.url)<a href="{{ event.url }}">{{ event.title }}</a>@else{{ event.title }}@endif</span>
          <span class="entry-desc">@if (event.place){{ event.place }}. @endif{{ event.detail }} <span class="entry-meta">{{ event.whenLabel }}</span></span>
        </li>
      @endforeach
    </ul>
  @endif

  @if (recent.length > 0)
    <h2 class="section-label">Recently</h2>
    <ul class="entry-list">
      @foreach (recent as event)
        <li>
          <span class="entry-name">@if (event.url)<a href="{{ event.url }}">{{ event.title }}</a>@else{{ event.title }}@endif</span>
          <span class="entry-desc">@if (event.place){{ event.place }}. @endif{{ event.detail }} <span class="entry-meta">{{ event.whenLabel }}</span></span>
        </li>
      @endforeach
    </ul>
  @endif

  <h2 class="section-label">Writing</h2>
  @if (posts.length > 0)
    <ul class="post-list">
      @foreach (posts as post)
        <li>
          <a href="/blog/{{ post.slug }}">
            <span class="post-main">
              <span class="post-title">{{ post.title }}</span>
              @if (post.excerpt)<span class="post-excerpt">{{ post.excerpt }}</span>@endif
              <span class="post-stats">{{ post.stats }}</span>
            </span>
            <time class="post-date" datetime="{{ post.date }}">{{ post.longDate }}</time>
          </a>
        </li>
      @endforeach
    </ul>
  @else
    <p class="empty-note">
      Nothing published yet. The first post is in the works; subscribe below
      and it lands in your inbox the moment it ships.
    </p>
  @endif

  @include('../partials/subscribe.stx')
@endsection
