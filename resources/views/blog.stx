<script server>
const fs = require('node:fs')
const path = require('node:path')
const { parseMarkdownWithFrontmatter } = require('@stacksjs/ts-md')
const { readingStats } = require(path.join(process.cwd(), 'resources/utils/reading-stats.ts'))

const title = 'Blog - Chris Breuer'
const description = 'Chris Breuer on developer and agentic tooling, on skyrunning and long days in the mountains, and on the places the two turn out to be the same problem.'
const activeNav = 'blog'
const pagePath = '/blog'

// The blog is stx-native: posts are markdown files in content/blog/*.md,
// parsed with our homegrown @stacksjs/ts-md (frontmatter + render). No
// BunPress. The framework yields /blog to this view because it exists.
const blogDir = path.join(process.cwd(), 'content/blog')
const posts = (fs.existsSync(blogDir) ? fs.readdirSync(blogDir) : [])
  .filter(f => f.endsWith('.md'))
  .map((f) => {
    const raw = fs.readFileSync(path.join(blogDir, f), 'utf-8')
    const { data } = parseMarkdownWithFrontmatter(raw)
    return {
      slug: f.replace(/\.md$/, ''),
      title: data.title,
      date: data.date,
      excerpt: data.excerpt || data.description || '',
      // The full day: several posts can land in the same month.
      day: typeof data.date === 'string' ? data.date : '',
      stats: readingStats(raw).label,
    }
  })
  .filter(p => p.title && p.date)
  .sort((a, b) => String(b.date).localeCompare(String(a.date)))
</script>

@layout('layouts/site')

@push('head')
  <link rel="alternate" type="application/rss+xml" title="Chris Breuer" href="/blog/feed.xml">
@endpush

@section('content')
  <h1 class="page-title">Writing</h1>
  <p class="page-lead">
    Both halves. Developer and agentic tooling on one side,
    <a href="https://stacksjs.com">Stacks</a> and the things engineers and
    their agents reach for. Long days in the mountains on the other. The
    posts that interest me most are the ones where those turn out to be the
    same problem.
  </p>

  @if (posts.length > 0)
    <ul class="post-list">
      @foreach (posts as post)
        <li>
          <a href="/blog/{{ post.slug }}">
            <span class="post-main">
              <span class="post-title">{{ post.title }}</span>
              <span class="post-stats">{{ post.stats }}</span>
            </span>
            <span class="post-date">{{ post.day }}</span>
          </a>
        </li>
      @endforeach
    </ul>
  @else
    <p class="empty-note">
      Nothing published yet. The first post is in the works; subscribe below
      and it lands in your inbox the moment it ships.
    </p>
  @endif

  @include('../partials/subscribe.stx')
@endsection

