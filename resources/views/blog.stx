<script server>
const path = require('node:path')
const { blogPosts } = require(path.join(process.cwd(), 'resources/utils/blog-posts.ts'))

const title = 'Blog - Chris Breuer'
const description = 'Chris Breuer on developer and agentic tooling, on skyrunning and long days in the mountains, and on the places the two turn out to be the same problem.'
const activeNav = 'blog'
const pagePath = '/blog'

// The blog is stx-native: posts are markdown files in content/blog/*.md,
// parsed with our homegrown @stacksjs/ts-md (frontmatter + render). No
// BunPress. The framework yields /blog to this view because it exists.
const posts = blogPosts()
</script>

@layout('layouts/site')

@push('head')
  <link rel="alternate" type="application/rss+xml" title="Chris Breuer" href="/blog/feed.xml">
@endpush

@section('content')
  <h1 class="page-title">Writing</h1>
  <p class="page-lead">
    Building software, training for the Pacific Crest Trail, and long days in the mountains with Mo.
  </p>

  @if (posts.length > 0)
    <ul class="post-list post-index">
      @foreach (posts as post)
        <li>
          <a href="/blog/{{ post.slug }}">
            <div class="post-main">
              <h2 class="post-title">{{ post.title }}</h2>
              @if (post.excerpt)<span class="post-excerpt">{{ post.excerpt }}</span>@endif
              <span class="post-stats">{{ post.stats }}</span>
            </div>
            <time class="post-date" datetime="{{ post.date }}">{{ post.longDate }}</time>
          </a>
        </li>
      @endforeach
    </ul>
  @else
    <p class="empty-note">
      Nothing published yet. The first post is in the works; subscribe below
      and it lands in your inbox the moment it ships.
    </p>
  @endif

  @include('../partials/subscribe.stx')
@endsection
