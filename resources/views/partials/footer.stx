<!-- A ridge closes every page: the divider rule above the footer, drawn as an
     elevation profile instead of a straight border.

     This is the real thing: the crest of the San Gabriel Mountains, west to
     east, from Newhall Pass on the left to the Lytle Creek end on the right:
     63 miles, 2,100 ft to 9,700 ft. The high point at roughly four-fifths
     across is Mount Baldy (10,064 ft); the long climb before it runs over
     Waterman, Islip, Throop and Baden-Powell, and the block after it is
     Telegraph, Icehouse Saddle and Cucamonga. Sampled off the USGS 3DEP 10 m
     DEM: stations every quarter mile along the divide, each one the highest
     point on a transect run across the crest, then generalised for a line
     drawn 32 units tall (scripts/build-ridge.ts regenerates it).

     Scales with the shell (preserveAspectRatio="none"); non-scaling-stroke
     keeps it a true 1px hairline at any width. Hovering it names the feature
     under the pointer, from content/ridge-peaks.json. -->
<div class="ridge-wrap">
  <svg class="ridge" viewBox="0 0 1200 32" preserveAspectRatio="none" role="img" aria-label="Elevation profile of the San Gabriel Mountains crest, west to east from Newhall Pass to Lytle Creek, high point Mount Baldy at 10,064 feet" focusable="false">
    <path d="M0.0 30.0 L8.6 28.4 L17.2 27.2 L20.0 27.4 L22.9 28.1 L25.8 27.9 L28.6 27.1 L34.4 24.8 L37.2 25.1 L40.1 26.2 L43.0 26.8 L45.8 26.7 L54.4 24.8 L60.1 24.7 L74.5 25.5 L88.8 27.3 L91.6 27.0 L97.4 25.0 L103.1 23.9 L108.8 24.0 L120.3 23.5 L126.0 22.0 L134.6 20.8 L140.3 21.3 L143.2 21.2 L148.9 20.4 L154.7 20.2 L166.1 21.0 L171.8 21.1 L177.6 20.9 L180.4 21.2 L189.0 20.6 L194.7 19.9 L203.3 20.0 L223.4 18.1 L229.1 17.9 L234.8 17.3 L237.7 17.5 L249.2 17.2 L254.9 17.6 L257.8 17.3 L263.5 16.1 L272.1 16.1 L274.9 15.7 L280.7 14.3 L286.4 13.9 L292.1 14.3 L306.4 17.2 L315.0 17.1 L337.9 16.0 L343.7 16.0 L346.5 16.2 L355.1 18.6 L358.0 19.1 L360.9 19.4 L366.6 19.2 L372.3 19.9 L375.2 19.6 L389.5 16.0 L398.1 14.3 L401.0 14.0 L409.5 15.1 L412.4 15.2 L415.3 15.6 L418.1 16.3 L421.0 16.5 L426.7 15.5 L429.6 15.9 L435.3 17.3 L438.2 17.0 L443.9 15.9 L446.8 16.3 L449.6 17.2 L452.5 17.3 L458.2 15.9 L464.0 15.2 L472.6 15.9 L484.0 15.5 L504.1 15.6 L521.2 12.2 L527.0 12.0 L532.7 10.8 L541.3 10.1 L547.0 9.0 L552.7 8.7 L561.3 9.2 L572.8 11.3 L581.4 11.4 L587.1 11.8 L592.8 10.9 L595.7 10.8 L601.4 11.9 L607.2 12.1 L612.9 13.0 L615.8 12.8 L621.5 11.2 L624.3 10.9 L630.1 11.9 L632.9 11.7 L644.4 8.4 L647.3 8.2 L650.1 8.8 L655.8 11.3 L658.7 12.3 L661.6 12.8 L667.3 12.6 L675.9 11.2 L684.5 12.2 L693.1 11.5 L698.8 9.9 L704.5 7.7 L716.0 5.4 L718.9 5.3 L727.4 6.9 L730.3 7.0 L733.2 6.8 L738.9 5.6 L744.6 5.8 L747.5 5.6 L758.9 4.2 L761.8 4.5 L764.7 5.3 L770.4 7.7 L779.0 11.9 L781.9 11.8 L784.7 9.6 L787.6 9.4 L790.5 10.3 L799.0 10.5 L804.8 11.2 L822.0 10.5 L830.5 10.7 L833.4 10.6 L847.7 9.1 L856.3 8.7 L867.8 7.1 L870.6 7.0 L882.1 7.5 L885.0 8.4 L890.7 11.1 L893.6 11.8 L899.3 10.7 L905.0 10.2 L910.7 8.7 L916.5 6.6 L927.9 4.8 L933.7 3.6 L939.4 4.3 L948.0 3.5 L950.8 3.5 L959.4 5.6 L962.3 5.1 L968.0 2.8 L970.9 2.0 L973.7 2.1 L979.5 3.5 L985.2 3.4 L988.1 3.7 L1005.3 8.4 L1008.1 9.0 L1011.0 9.3 L1013.8 9.2 L1016.7 8.7 L1022.4 7.5 L1028.2 7.3 L1033.9 5.9 L1036.8 5.9 L1039.6 6.3 L1045.3 8.5 L1048.2 9.1 L1051.1 8.8 L1053.9 8.2 L1059.7 8.2 L1065.4 7.8 L1068.3 8.3 L1071.1 9.1 L1074.0 9.2 L1079.7 7.0 L1082.6 6.3 L1085.4 6.5 L1094.0 7.3 L1102.6 11.5 L1105.5 12.7 L1116.9 15.5 L1119.8 16.0 L1122.7 15.9 L1128.4 14.7 L1134.1 14.6 L1139.9 15.2 L1145.6 15.4 L1159.9 17.9 L1165.6 17.6 L1171.4 18.3 L1182.8 18.9 L1191.4 20.1 L1200.0 20.7" vector-effect="non-scaling-stroke" />
  </svg>
  <!-- Hover targets, tiled across the whole line so a pointer anywhere on it
       names the nearest feature rather than finding dead space between peaks.
       Pure markup and CSS: nothing to bind, so it survives a client-side
       navigation without a listener to re-attach. Hidden from assistive tech,
       which is served by the label on the graphic itself. -->
  <div class="ridge-peaks" aria-hidden="true">
    @foreach (ridgePeaks as peak)
      <span class="ridge-peak is-{{ peak.anchor }}" style="left: {{ peak.left }}%; width: {{ peak.width }}%; --at: {{ peak.at }}%">
        <span class="ridge-peak-name">{{ peak.name }} <span class="ridge-peak-ft">{{ peak.ftLabel }} ft</span></span>
      </span>
    @endforeach
  </div>
</div>
