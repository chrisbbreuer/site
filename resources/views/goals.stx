<script server>
const fs = require('node:fs')
const path = require('node:path')

const title = 'Goals - Chris Breuer'
const description = 'What I am working toward: a billion npm downloads a month, an open unicorn, Stacks v1.0, the Pacific Crest Trail, and every US national park.'
const activeNav = 'goals'
const pagePath = '/goals'

// The download goal reads its own scoreboard. content/projects.json is
// resynced daily by .github/workflows/projects-sync.yml, so this number moves
// on its own rather than being a figure I typed once and forgot.
const projects = JSON.parse(fs.readFileSync(path.join(process.cwd(), 'content/projects.json'), 'utf-8'))
const monthly = projects.repos.reduce((sum, r) => sum + (r.downloads || 0), 0)
// Packages, not repositories. A monorepo that ships eighty-five of them is one
// row on /projects and eighty-five things people actually install.
const packageCount = projects.repos.reduce((sum, r) => sum + (r.downloads ? (r.pkgCount || 1) : 0), 0)
const TARGET = 1000000000

function compact(n) {
  if (n >= 1000000000)
    return `${(n / 1000000000).toFixed(2).replace(/\.?0+$/, '')}B`
  if (n >= 1000000)
    return `${(n / 1000000).toFixed(1).replace(/\.0$/, '')}M`
  if (n >= 1000)
    return `${Math.round(n / 1000)}k`
  return String(n)
}

const monthlyLabel = compact(monthly)
// A multiple is the honest way to say it. The percentage, 0.3%, is true and
// tells you nothing; "325 times from here" tells you what kind of problem it is.
const multiple = Math.round(TARGET / Math.max(monthly, 1))
const sharePercent = ((monthly / TARGET) * 100).toFixed(2)

// A goal that can be counted gets a bar. `done` and `total` are the count, and
// `label` is what the bar says in words. The fill is never narrower than a
// hairline once there is any progress, so a real 0.3% still shows up as a
// start rather than as nothing.
function progress(done, total, label) {
  const ratio = Math.min(Math.max(done / total, 0), 1)
  return {
    label,
    width: done > 0 ? `max(2px, ${(ratio * 100).toFixed(2)}%)` : '0',
    valueNow: Math.round(ratio * 100),
  }
}

const NATIONAL_PARKS = 63
const parksVisited = 20

// Deliberately short. A list of twenty goals is a list of none, and a goal
// with no way to tell whether it happened is a mood. Each of these is
// something someone else could check.
const work = [
  {
    name: 'A billion downloads a month',
    url: '/projects',
    text: `The whole point of the tooling, stated as a number someone else can check. `
      + `Today it is ${monthlyLabel} a month across ${packageCount} published packages. `
      + `That is ${sharePercent}% of the way, or about ${multiple}× from here. `
      + `It resyncs daily, so this page marks its own homework.`,
    progress: progress(monthly, TARGET, `${monthlyLabel} of 1B a month`),
  },
  { name: 'Stacks v1.0', url: 'https://stacksjs.com', text: 'The framework stops being a moving target. A stable API, documentation that matches it, fast and energy efficient by default with published benchmarks to show it, and a version number I am willing to ask other people to depend on.' },
  { name: 'Wildloop', url: 'https://wildloop.org', text: 'Ship the territory game properly: captures the server can stand behind, clubs and challenges people come back to, and route records worth chasing.' },
  { name: 'HQ.training', url: 'https://hq.training', text: 'Make it the thing coaches reach for first: training analysis that earns its place next to the billing and the scheduling, rather than sitting in a separate tab.' },
]

const personal = [
  { name: 'Pacific Crest Trail', text: 'Northbound, 2,650 miles, aiming to average 60 a day. I do not know yet if that pace holds. Finding out is half the point.' },
  { name: 'Race it', text: 'Once the trail is done, start pinning on a number at mountain races to see where I stand.' },
  { name: 'Train in the open', text: 'Run the build in public the same way the code is: the days it goes well and the days it does not.' },
  {
    name: 'Every national park',
    text: `All ${NATIONAL_PARKS} in the US. I have been to ${parksVisited} so far.`,
    progress: progress(parksVisited, NATIONAL_PARKS, `${parksVisited} of ${NATIONAL_PARKS} parks`),
  },
]
</script>

@layout('layouts/site')

@section('content')
  <h1 class="page-title">Goals.</h1>
  <p class="page-lead">
    Written down and put somewhere public, which is the only version of a goal
    that has ever worked for me. Two lists, same rule for both: something
    another person could look at and tell whether it happened. The first one
    keeps its own score.
  </p>

  <blockquote class="pull-quote">
    <p>
      Be brave. Nothing on this page was a safe bet the day I wrote it down,
      and that is the whole point. A goal you are certain of is not a
      goal, it is a schedule. Taking the risk is the part that costs something.
    </p>
    <footer>me, to myself, repeatedly</footer>
  </blockquote>

  <h2 class="section-label">Work</h2>
  <ul class="entry-list">
    @foreach (work as goal)
      <li>
        <span class="entry-name"><a href="{{ goal.url }}">{{ goal.name }}</a></span>
        <span class="entry-desc">{{ goal.text }}
          @if (goal.progress)
            <span class="goal-progress">
              <span class="goal-bar" role="progressbar" aria-label="{{ goal.progress.label }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ goal.progress.valueNow }}"><span class="goal-bar-fill" style="width: {{ goal.progress.width }}"></span></span>
              <span class="goal-bar-label">{{ goal.progress.label }}</span>
            </span>
          @endif
        </span>
      </li>
    @endforeach
  </ul>

  <h2 class="section-label">Outside</h2>
  <ul class="entry-list">
    @foreach (personal as goal)
      <li>
        <span class="entry-name">{{ goal.name }}</span>
        <span class="entry-desc">{{ goal.text }}
          @if (goal.progress)
            <span class="goal-progress">
              <span class="goal-bar" role="progressbar" aria-label="{{ goal.progress.label }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ goal.progress.valueNow }}"><span class="goal-bar-fill" style="width: {{ goal.progress.width }}"></span></span>
              <span class="goal-bar-label">{{ goal.progress.label }}</span>
            </span>
          @endif
        </span>
      </li>
    @endforeach
  </ul>

  <p class="empty-note">
    The training behind the running half is
    <a href="https://hq.training/share/chris">public</a>: two years of
    it, on <a href="https://hq.training">HQ.training</a>, the same app I build
    for everyone else, pointed at my own weeks.
  </p>
@endsection
