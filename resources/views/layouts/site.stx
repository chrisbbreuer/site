<script server>
// Fallback page meta. Every page overrides these from its own server script
// (page values win; this stub only fills the gaps).
const title = 'Chris Breuer - Software engineer and founder'
const description = 'Chris Breuer is a software engineer and founder of Stacks. Notes on developer tooling, TypeScript, and Bun.'
const activeNav = ''
const siteUrl = 'https://chrisbreuer.me'
// pagePath comes from the page's server script; guard for pages that omit it.
const canonicalUrl = `${siteUrl}${typeof pagePath === 'string' ? pagePath : ''}`
// Per-page OG card, derived from the path. Blog posts fall back to the blog
// card; anything unmapped uses the home card.
const ogSlugs = ['about', 'projects', 'uses', 'blog']
const ogSeg = typeof pagePath === 'string' && pagePath !== '/' ? pagePath.split('/')[1] : 'home'
const ogImage = `${siteUrl}/images/og/${ogSlugs.includes(ogSeg) ? ogSeg : 'home'}.jpg`
</script>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ canonicalUrl }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ canonicalUrl }}">
  <meta property="og:site_name" content="Chris Breuer">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:image" content="{{ ogImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@chrisbbreuer">
  <meta name="twitter:creator" content="@chrisbbreuer">
  <meta name="twitter:title" content="{{ title }}">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image" content="{{ ogImage }}">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  @stack('head')
  <link rel="preload" href="/fonts/lilex/Lilex-var.woff2" as="font" type="font/woff2" crossorigin>
  <script src="/assets/scripts/theme.js"></script>
  <link rel="stylesheet" href="/site.css">
</head>
<body>
  <div class="shell">
    @include('../partials/masthead.stx')

    <main>
      @yield('content')
    </main>

    @include('../partials/footer.stx')
  </div>
  <!-- Gallery placeholder + lightbox scripts load on every page so their
       `stx:load` listeners survive SPA navigation (the router doesn't execute
       page-pushed <script> tags on client-side nav). Both no-op off the About
       page. -->
  <script src="/assets/scripts/splathash.js"></script>
  <script src="/assets/scripts/gallery.js"></script>
  @stack('scripts')
</body>
</html>
