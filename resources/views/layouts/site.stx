<script server>
const fs = require('node:fs')
const path = require('node:path')

// Static assets are served with a one-hour Cache-Control and no validator, so
// an expired one is re-downloaded rather than revalidated. stx gives a
// filename carrying a hash `max-age=31536000, immutable` instead, so
// `bun scripts/build-assets.ts` writes hashed copies and this manifest.
// Missing manifest (a dev run that skipped the script) falls back to the
// plain path, which is still served, just not cached as long.
let assetManifest = {}
try {
  assetManifest = JSON.parse(fs.readFileSync(path.join(process.cwd(), 'content/assets.json'), 'utf-8'))
}
catch {}
// Only in production. The hashed copies are made by a build step, so in
// development they are whatever that step last wrote - edit site.css, reload,
// and the page would keep serving the previous hash with no sign anything was
// ignored. Dev serves the file on disk.
const fingerprintAssets = (process.env.APP_ENV || process.env.NODE_ENV || '').toLowerCase() === 'production'

function asset(p) {
  return fingerprintAssets ? (assetManifest[p] || p) : p
}

// Hover targets for the footer ridge, written by scripts/build-ridge.ts from
// the same guide the line is sampled along, so a peak's label and the bump it
// names cannot drift apart. Empty is fine: the ridge just stops being
// hoverable.
let ridgePeaks = []
try {
  ridgePeaks = JSON.parse(fs.readFileSync(path.join(process.cwd(), 'content/ridge-peaks.json'), 'utf-8'))
}
catch {}

// Fallback page meta. Every page overrides these from its own server script
// (page values win; this stub only fills the gaps).
const title = 'Chris Breuer - Software engineer, founder & skyrunner'
const description = 'Chris Breuer builds developer tooling and skyruns long days in the mountains. Notes on TypeScript, Bun, Stacks, and the trails in between.'
const activeNav = ''
const siteUrl = 'https://chrisbreuer.me'
// pagePath comes from the page's server script; guard for pages that omit it.
const canonicalUrl = `${siteUrl}${typeof pagePath === 'string' ? pagePath : ''}`
// Per-page OG card, derived from the path. Blog posts fall back to the blog
// card; anything unmapped uses the home card.
const ogSlugs = ['about', 'apps', 'goals', 'projects', 'uses', 'blog']
const ogSeg = typeof pagePath === 'string' && pagePath !== '/' ? pagePath.split('/')[1] : 'home'

// A post gets its own card, named for its slug, and falls back to the generic
// blog one when that card has not been generated yet. A card with the post's
// own title on it is the difference between a share that says what was
// written and one that says "Blog".
const postSlug = typeof pagePath === 'string' && pagePath.startsWith('/blog/') ? pagePath.slice('/blog/'.length) : ''
const postCard = postSlug ? `blog-${postSlug}` : ''
const ogCard = postCard && fs.existsSync(path.join(process.cwd(), 'public/images/og', `${postCard}.jpg`))
  ? postCard
  : (ogSlugs.includes(ogSeg) ? ogSeg : 'home')
const ogImage = `${siteUrl}/images/og/${ogCard}.jpg`

// A post is an article, and the crawlers that care read the date off it.
//
// Read the way pagePath is read, behind a typeof guard and never declared
// here: a `const` of the same name in this script shadows the value the page
// set, which is how this silently stayed a "website" the first time.
const ogArticleValue = typeof ogArticle === 'undefined' ? null : ogArticle
const ogType = ogArticleValue && typeof ogArticleValue === 'object' ? 'article' : 'website'
const ogPublished = ogType === 'article' ? String(ogArticleValue.published || '') : ''
</script>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ canonicalUrl }}">
  <meta property="og:type" content="{{ ogType }}">
  <meta property="og:url" content="{{ canonicalUrl }}">
  <meta property="og:site_name" content="Chris Breuer">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:image" content="{{ ogImage }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@chrisbbreuer">
  <meta name="twitter:creator" content="@chrisbbreuer">
  <meta name="twitter:title" content="{{ title }}">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image" content="{{ ogImage }}">
  @if (ogPublished)
    <meta property="article:published_time" content="{{ ogPublished }}">
    <meta property="article:author" content="Chris Breuer">
    <meta name="author" content="Chris Breuer">
  @endif
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  @stack('head')
  <link rel="preload" href="{{ asset('/fonts/lilex/Lilex-var.woff2') }}" as="font" type="font/woff2" crossorigin>
  <script src="{{ asset('/assets/scripts/theme.js') }}"></script>
  <link rel="stylesheet" href="{{ asset('/site.css') }}">
</head>
<body>
  <div class="shell">
    @include('../partials/masthead.stx')

    <main>
      @yield('content')
    </main>

    @include('../partials/footer.stx')
  </div>
  <!-- Gallery placeholder + lightbox scripts load on every page so their
       `stx:load` listeners survive SPA navigation (the router doesn't execute
       page-pushed <script> tags on client-side nav). Both no-op off the About
       page. -->
  <script src="{{ asset('/assets/scripts/site.js') }}"></script>
  <script src="{{ asset('/assets/scripts/splathash.js') }}"></script>
  <script src="{{ asset('/assets/scripts/gallery.js') }}"></script>
  @stack('scripts')
</body>
</html>
