<script server>
const fs = require('node:fs')
const path = require('node:path')

const title = 'Projects - Chris Breuer'
const description = 'Every public repo Chris Breuer authored or maintains, across stacksjs, zig-utils, meemalabs, and more.'
const activeNav = 'projects'
const pagePath = '/projects'

// content/projects.json is regenerated from the GitHub API by
// `bun scripts/fetch-projects.ts`. Curation (exclusions, pinned repos like
// dotfiles, emoji stripping) lives in that script, so a resync keeps it.
const data = JSON.parse(fs.readFileSync(path.join(process.cwd(), 'content/projects.json'), 'utf-8'))

// 4-digit counts read fine in full; past that the digits stop carrying
// meaning on a line of body text and a rounded 12.4k says the same thing.
function compact(n) {
  if (n >= 1000000)
    return `${(n / 1000000).toFixed(1).replace(/\.0$/, '')}M`
  if (n >= 10000)
    return `${Math.round(n / 1000)}k`
  if (n >= 1000)
    return `${(n / 1000).toFixed(1).replace(/\.0$/, '')}k`
  return String(n)
}

const withLabels = data.repos.map((r) => {
  const parts = []
  if (r.stars > 0)
    parts.push(`${compact(r.stars)} ${r.stars === 1 ? 'star' : 'stars'}`)
  // Only npm-published repos carry a download count; the Zig and app repos
  // simply have nothing to say here, so they show stars alone.
  if (r.downloads > 0)
    parts.push(`${compact(r.downloads)}/mo`)
  return {
    ...r,
    // r.tags comes from GitHub language + topics (see scripts/fetch-projects.ts).
    tags: r.tags || [],
    starLabel: parts.join(' · '),
    filterText: `${r.name} ${r.description || ''}`.toLowerCase(),
  }
})

// Highlights: hand-picked rather than ranked, and kept in this order — the
// stars-first list kept burying the small, load-bearing packages. `org/name`
// where the bare name is ambiguous (there are two `fonts` repos).
const HIGHLIGHTS = [
  'stacksjs/stacks',
  'stacksjs/dtsx',
  'national-park-service/fonts',
  'stacksjs/rpx',
  'stacksjs/tlsx',
  'stacksjs/ts-images',
  'stacksjs/ts-spreadsheets',
  'stacksjs/bun-queue',
]
const bySlug = {}
for (const r of withLabels)
  bySlug[`${r.org}/${r.name}`] = r
// A repo that got renamed or archived out of projects.json drops off the list
// rather than rendering a blank row.
const highlights = HIGHLIGHTS.map(slug => bySlug[slug]).filter(Boolean)

// Everything, grouped per org (the JSON is already in display order).
const groups = []
for (const repo of withLabels) {
  let group = groups[groups.length - 1]
  if (!group || group.org !== repo.org) {
    group = { org: repo.org, orgUrl: `https://github.com/${repo.org}`, repos: [] }
    groups.push(group)
  }
  group.repos.push(repo)
}
for (const group of groups)
  group.countLabel = group.repos.length === 1 ? '1 repo' : `${group.repos.length} repos`

const orgList = groups.map(g => g.org)

// Tag chips: only the ones with enough repos to be worth a filter, most common first.
const tagCounts = {}
for (const r of withLabels)
  for (const t of r.tags) tagCounts[t] = (tagCounts[t] || 0) + 1
const tagList = Object.keys(tagCounts).filter(t => tagCounts[t] >= 4).sort((a, b) => tagCounts[b] - tagCounts[a])

const repoCount = withLabels.length
const orgCount = groups.length
const generatedAt = data.generatedAt
const monthlyTotal = withLabels.reduce((sum, r) => sum + (r.downloads || 0), 0)
const publishedCount = withLabels.filter(r => r.downloads > 0).length
const totalLabel = compact(monthlyTotal)
</script>

@layout('layouts/site')

@section('content')
  <h1 class="page-title">Things I've made.</h1>
  <p class="page-lead">
    {{ repoCount }} public repos across {{ orgCount }} orgs, most of them open source.
    {{ publishedCount }} of them ship to npm, {{ totalLabel }} downloads a month between
    them. If something piques your interest, read the code and send a patch &mdash; my
    <a href="https://github.com/chrisbbreuer/dotfiles">dotfiles</a> are public too.
    Stars and downloads resync daily; last on {{ generatedAt }}.
  </p>

  <div class="proj-filter">
    <input type="search" class="proj-search" placeholder="Filter by name or description" aria-label="Filter projects" autocomplete="off">
    <div class="proj-facets">
      <div class="proj-chips" role="group" aria-label="Filter by tag">
        <button type="button" class="proj-chip is-active" data-tag="" aria-pressed="true">All tags</button>
        @foreach (tagList as tag)
          <button type="button" class="proj-chip" data-tag="{{ tag }}" aria-pressed="false">{{ tag }}</button>
        @endforeach
      </div>
      <div class="proj-chips" role="group" aria-label="Filter by org">
        <button type="button" class="proj-chip is-active" data-org="" aria-pressed="true">All orgs</button>
        @foreach (orgList as org)
          <button type="button" class="proj-chip" data-org="{{ org }}" aria-pressed="false">{{ org }}</button>
        @endforeach
      </div>
    </div>
  </div>

  <section class="proj-section proj-highlights">
    <h2 class="section-label">Highlights</h2>
    <ul class="entry-list">
      @foreach (highlights as repo)
        <li>
          <span class="entry-name"><a href="{{ repo.url }}">{{ repo.org }}/{{ repo.name }}</a></span>
          <span class="entry-desc">{{ repo.description }} <span class="entry-meta">{{ repo.starLabel }}</span></span>
        </li>
      @endforeach
    </ul>
  </section>

  <p class="proj-empty" hidden>No projects match that filter.</p>

  @foreach (groups as group)
    <section class="proj-section proj-group">
      <h2 class="section-label">
        <a href="{{ group.orgUrl }}">{{ group.org }}</a>
        <span class="label-meta">{{ group.countLabel }}</span>
      </h2>
      <ul class="entry-list">
        @foreach (group.repos as repo)
          <li data-org="{{ repo.org }}" data-text="{{ repo.filterText }}" data-tags="{{ repo.tags.join(' ') }}">
            <span class="entry-name"><a href="{{ repo.url }}">{{ repo.name }}</a></span>
            <span class="entry-desc">{{ repo.description }} <span class="entry-meta">{{ repo.starLabel }}</span></span>
          </li>
        @endforeach
      </ul>
    </section>
  @endforeach
@endsection
