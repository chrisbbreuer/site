<script server>
const fs = require('node:fs')
const path = require('node:path')

const title = 'About - Chris Breuer'
const description = 'I\'m Chris Breuer, a software engineer obsessed over developer and agentic tooling, and a skyrunner. Building Stacks, HQ.training and Wildloop. Los Angeles based.'
const activeNav = 'about'
const pagePath = '/about'

// Photos: built by `bun scripts/build-gallery.ts` from my photo dump. All of
// them flow into one masonry that wraps around the bio and portrait, the
// layout is computed by /assets/scripts/gallery.js (aspect ratios are known
// up front, so there's no reflow on load).
const gallery = JSON.parse(fs.readFileSync(path.join(process.cwd(), 'content/gallery.json'), 'utf-8'))

// The apps, not the repos, /projects already lists everything public from the
// GitHub API. HQ.training and Wildloop are here because they are where the two
// halves of the bio meet: athlete software written by someone who needs it.
const building = [
  { name: 'Stacks', url: 'https://stacksjs.com', text: 'A TypeScript framework, and the open-source ecosystem that grew around it.' },
  { name: 'HQ.training', url: 'https://hq.training', text: 'An operating system for gyms, coaches and athletes.' },
  { name: 'Wildloop', url: 'https://wildloop.org', text: 'Trails and GPS recording. Close a loop and you claim the ground inside it.' },
  // OpenFarm is hidden for now, to match /apps where it is commented out the
  // same way. The home page carries the third copy of this list; it has no
  // server-side array to comment in, so the entry was removed there outright.
  // Restoring means all three.
  // { name: 'OpenFarm', url: 'https://openfarm.ing', text: 'Autonomous drone scouting and targeted treatment for farms.' },
]

const work = [
  { name: 'Stacks.js, Inc.', role: 'Founder', period: '2024 to present' },
  { name: 'Bisnow', role: 'Senior Software Engineer', period: '2023 to 2024' },
  { name: 'Bixolon', role: 'Consultant', period: '2020 to 2024' },
  { name: 'University of Oregon', role: 'Consultant', period: '2020 to 2021' },
  { name: 'Girlgaze', role: 'Consultant', period: '2019 to 2020' },
]

const elsewhere = [
  { name: 'GitHub', url: 'https://github.com/chrisbbreuer', text: 'Code, most days.' },
  { name: 'Bluesky', url: 'https://bsky.app/profile/chrisbreuer.me', text: 'Shorter thoughts.' },
  { name: 'LinkedIn', url: 'https://www.linkedin.com/in/%F0%9F%8C%B1-chris-breuer-33231765/' },
  { name: 'Email', url: 'mailto:hi@chrisbreuer.me', text: 'hi@chrisbreuer.me' },
]
</script>

@layout('layouts/site')

@section('content')
  <div class="about-wrap">
    <div class="bio-col">
      <h1 class="page-title">Obsessed with developer tooling and steep trails.</h1>
      <div class="prose">
        <p>
          Ever since I was young, I've loved to explore, learn, and create, especially
          while using tech. When I was 12 years old, I wrote my first SaaS app, and to
          my surprise it turned out quite successful and brought in several hundred
          dollars monthly via Google AdSense.
        </p>
        <p>
          The only thing I loved more than computers as a kid was sports and the
          outdoors. That took me to university in Hawaii, where I played NCAA soccer.
          Almost 20 years later, not much has changed. It just got steeper.
          These days it is skyrunning: long days in the mountains, on trails that go
          up far more than they go along, with my dog setting the pace. It is still
          the one thing that reliably peels me away from my desk.
        </p>
        <p>
          I am not really a runner, though. I have been an athlete most of my life,
          but running never brought me much joy, and I have never done it
          professionally. The point is less the running than showing that a strong
          mind with a clear goal can get you almost anywhere. It is also good for
          the dog.
        </p>
        <p>
          Next up is the Pacific Crest Trail, northbound: 2,650 miles, aiming to
          average 60 a day. I do not know yet if that pace holds, and finding out is
          half the reason to try. After that I want to start racing, pinning on a
          number at mountain races to see where I stand. I will share how both go
          here, including the days that do not go to plan.
        </p>
        <p>
          I spent the last 15+ years working on personal and private projects, ranging
          from small apps to large enterprise services, which caused my obsession with
          building scalable systems. I dove deep into data storage and
          transfer, and distributed and decentralized compute techniques. That was a
          core reason I started working on Stacks.
        </p>
        <p>
          The thing that has never changed is where the work comes from. Every
          project I have started began as something I, my team, or the community
          around us actually needed, where the paid tools were the only ones
          doing it well and nothing open source came close enough to compete.
          Stacks because I kept rewriting the same infrastructure
          underneath every app, the athlete software because I wanted to use it
          myself. It is a narrow filter for deciding what to build, and it is
          the reason any of it gets finished.
        </p>
        <p>
          The two halves feed each other more than you would think. A long day in the
          mountains is mostly about pacing, small decisions compounding, and being
          honest with yourself about what is actually working, which is also a
          fair description of shipping software.
        </p>
        <p>
          Today that is <a href="https://stacksjs.com">Stacks</a> and its broader ecosystem,
          and a growing amount of agentic tooling. The tools engineers use are quickly
          becoming the tools their agents use, and that changes what a good one looks like.
          On top of it sit the apps. Lately that means
          <a href="https://hq.training">HQ.training</a> and
          <a href="https://wildloop.org">Wildloop</a>: athlete software I wrote because I
          needed it to exist. Follow along on
          <a href="https://github.com/chrisbbreuer">GitHub</a> for the latest.
        </p>
      </div>

      <h2 class="section-label">Building</h2>
      <ul class="entry-list">
        @foreach (building as project)
          <li>
            <span class="entry-name"><a href="{{ project.url }}">{{ project.name }}</a></span>
            <span class="entry-desc">{{ project.text }}</span>
          </li>
        @endforeach
      </ul>

      <h2 class="section-label">Work</h2>
      <ul class="entry-list">
        @foreach (work as job)
          <li>
            <span class="entry-name">{{ job.name }}</span>
            <span class="entry-desc">{{ job.role }} <span class="entry-meta">{{ job.period }}</span></span>
          </li>
        @endforeach
      </ul>

      <h2 class="section-label">Elsewhere</h2>
      <ul class="entry-list">
        @foreach (elsewhere as place)
          <li>
            <span class="entry-name"><a href="{{ place.url }}" rel="me">{{ place.name }}</a></span>
            @if (place.url.startsWith('mailto:'))
              <span class="entry-desc"><a href="{{ place.url }}">{{ place.text }}</a></span>
            @else
              <span class="entry-desc">{{ place.text }}</span>
            @endif
          </li>
        @endforeach
      </ul>
    </div>

    <aside class="portrait-col">
      <img src="/images/chris.jpg" alt="Chris Breuer" width="480" height="480">
      <p class="portrait-note">Los Angeles based. Usually on a trail with the dogs when I'm not at the keyboard.</p>
    </aside>

    <div class="photo-masonry" aria-label="Photographs">
      @foreach (gallery as photo)
        <button type="button" class="gallery-item" data-full="{{ photo.lg }}" data-hash="{{ photo.hash }}" data-w="{{ photo.width }}" data-h="{{ photo.height }}" style="aspect-ratio: {{ photo.width }} / {{ photo.height }}" aria-label="Open photograph">
          <img src="{{ photo.sm }}" alt="" width="{{ photo.smWidth }}" height="{{ photo.smHeight }}" loading="lazy" decoding="async">
        </button>
      @endforeach
    </div>
  </div>
@endsection
