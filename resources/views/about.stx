<script server>
const fs = require('node:fs')
const path = require('node:path')

const title = 'About - Chris Breuer'
const description = 'I\'m Chris Breuer, a software engineer obsessed with developer and agentic tooling, and an ultra skyrunner. Building Stacks, HQ.training and Wildloop. Based in Los Angeles.'
const activeNav = 'about'
const pagePath = '/about'

// Photos: built by `bun scripts/build-gallery.ts` from my photo dump. All of
// them flow into one masonry that wraps around the bio and portrait, the
// layout is computed by /assets/scripts/gallery.js (aspect ratios are known
// up front, so there's no reflow on load).
const gallery = JSON.parse(fs.readFileSync(path.join(process.cwd(), 'content/gallery.json'), 'utf-8'))
  .map((photo) => ({
    ...photo,
    // What the lightbox loads. `xl` is the variant worth opening; `lg` is the
    // fallback for photos added before that variant existed.
    full: photo.xl || photo.lg,
    alt: photo.alt || '',
    // A photo with a description is announced by it. One without stays alt=""
    // rather than "Photograph", which tells a screen reader nothing it could
    // not already work out and is worse than silence.
    label: photo.alt ? `Open photograph. ${photo.alt}` : 'Open photograph',
  }))

// The apps, not the repos, /projects already lists everything public from the
// GitHub API. HQ.training and Wildloop are here because they are where the two
// halves of the bio meet: athlete software written by someone who needs it.
const building = [
  { name: 'Stacks', url: 'https://stacksjs.com', text: 'A TypeScript framework, and the open-source ecosystem that grew around it.' },
  { name: 'HQ.training', url: 'https://hq.training', text: 'An operating system for gyms, coaches and athletes.' },
  { name: 'Wildloop', url: 'https://wildloop.org', text: 'Trails and GPS recording. Close a loop and you claim the ground inside it.' },
  // OpenFarm is hidden for now, to match /apps where it is commented out the
  // same way. The home page carries the third copy of this list; it has no
  // server-side array to comment in, so the entry was removed there outright.
  // Restoring means all three.
  // { name: 'OpenFarm', url: 'https://openfarm.ing', text: 'Autonomous drone scouting and targeted treatment for farms.' },
]

const work = [
  { name: 'Stacks.js, Inc.', role: 'Founder', period: '2024 to present' },
  // Hidden for now: the longer role wraps and breaks the rhythm of the list.
  // { name: 'Bisnow', role: 'Senior Software Engineer', period: '2023 to 2024' },
  { name: 'CION Agency', role: 'Founder', period: '2018 to 2024' },
  { name: 'Bixolon', role: 'Consultant', period: '2020 to 2024' },
  { name: 'University of Oregon', role: 'Consultant', period: '2020 to 2021' },
  { name: 'Girlgaze', role: 'Consultant', period: '2019 to 2020' },
]

const elsewhere = [
  { name: 'GitHub', url: 'https://github.com/chrisbbreuer', text: 'Code, most days.' },
  { name: 'Bluesky', url: 'https://bsky.app/profile/chrisbreuer.me', text: 'Shorter thoughts.' },
  { name: 'LinkedIn', url: 'https://www.linkedin.com/in/%F0%9F%8C%B1-chris-breuer-33231765/' },
  { name: 'Email', url: 'mailto:hi@chrisbreuer.me', text: 'hi@chrisbreuer.me' },
]
</script>

@layout('layouts/site')

@section('content')
  <div class="about-wrap">
    <div class="bio-col">
      <h1 class="page-title">Obsessed with developer tooling and steep trails.</h1>
      <div class="prose">
        <p>
          Ever since I was young, I've loved to explore, learn and build, mostly with
          tech. At 12 I wrote my first SaaS app, and to my surprise it brought in
          several hundred dollars a month through Google AdSense.
        </p>
        <p>
          The only thing I loved more than computers as a kid was sports and the
          outdoors. That took me to university in Hawaii to play NCAA soccer. Almost
          20 years later not much has changed, it just got steeper. These days it is
          skyrunning: long days on trails that go up far more than they go along,
          with Mo, my Kangal, setting the pace. It is still the one thing that
          reliably pulls me away from my desk.
        </p>
        <p>
          I am not really a runner, though. I have been an athlete most of my life,
          but running on its own never brought me much joy, and I have never done it
          professionally. I know I will never be the fastest one on the mountain. I
          also know I will not quit. The point was never the running. It is showing
          that a strong mind with a clear goal can get you almost anywhere. It is
          also good for the dog.
        </p>
        <p>
          Next up is the Pacific Crest Trail, northbound: 2,650 miles at an average
          of 60 a day. I do not know yet if that pace holds, and finding out is half
          the reason to go. After that, maybe a race or two, something like the
          Tor des Géants, though 2,650 miles will probably change what I want out
          of all this. I will share all of it here, including the days that do not
          go to plan.
        </p>
        <p>
          For the last 15+ years I have built personal and private projects, from
          small apps to large enterprise services, which is where my obsession with
          scalable systems comes from. I went deep on data storage and transfer, and
          on distributed and decentralized compute. That is a big part of why I
          started Stacks.
        </p>
        <p>
          The goal behind all of it is software that is as fast and energy efficient
          as it can be. In the age of AI that matters more than ever: every request an
          agent makes runs on real hardware and real power, and most of it passes
          through ordinary code on the way. Good abstractions are one of the few
          levers that scale. Get the defaults right once, in something like Stacks,
          and every app built on top does less work for the same result.
        </p>
        <p>
          What has never changed is where the work comes from. Every project I have
          started began as something I, my team or the community around us actually
          needed, where only paid tools did it well and nothing open source came
          close. Stacks, because I kept rewriting the same infrastructure under every
          app. The athlete software, because I wanted to use it myself. It is a
          narrow filter for what to build, and it is the reason any of it gets
          finished.
        </p>
        <p>
          The two halves feed each other more than you would think. A long day in the
          mountains is mostly pacing, small decisions compounding, and being honest
          with yourself about what is actually working. That is also a fair
          description of shipping software. So is refusing to quit.
        </p>
        <p>
          Today that means <a href="https://stacksjs.com">Stacks</a> and its broader
          ecosystem, and a growing amount of agentic tooling. The tools engineers use
          are quickly becoming the tools their agents use, and that changes what a
          good one looks like. On top of it sit the apps, lately
          <a href="https://hq.training">HQ.training</a> and
          <a href="https://wildloop.org">Wildloop</a>: athlete software I wrote because
          I needed it to exist. Follow along on
          <a href="https://github.com/chrisbbreuer">GitHub</a> for the latest.
        </p>
      </div>

      <h2 class="section-label">Building</h2>
      <ul class="entry-list">
        @foreach (building as project)
          <li>
            <span class="entry-name"><a href="{{ project.url }}">{{ project.name }}</a></span>
            <span class="entry-desc">{{ project.text }}</span>
          </li>
        @endforeach
      </ul>

      <h2 class="section-label">Work</h2>
      <ul class="entry-list">
        @foreach (work as job)
          <li>
            <span class="entry-name">{{ job.name }}</span>
            <span class="entry-desc">{{ job.role }} <span class="entry-meta">{{ job.period }}</span></span>
          </li>
        @endforeach
      </ul>

      <h2 class="section-label">Elsewhere</h2>
      <ul class="entry-list">
        @foreach (elsewhere as place)
          <li>
            <span class="entry-name"><a href="{{ place.url }}" rel="me">{{ place.name }}</a></span>
            @if (place.url.startsWith('mailto:'))
              <span class="entry-desc"><a href="{{ place.url }}">{{ place.text }}</a></span>
            @else
              <span class="entry-desc">{{ place.text }}</span>
            @endif
          </li>
        @endforeach
      </ul>
    </div>

    <aside class="portrait-col">
      <img src="/images/chris.jpg" alt="Chris Breuer" width="480" height="480">
      <p class="portrait-note">Los Angeles based. Usually on a trail with the dog when I'm not at the keyboard.</p>
    </aside>

    <div class="photo-masonry" aria-label="Photographs">
      @foreach (gallery as photo)
        <button type="button" class="gallery-item" data-full="{{ photo.full }}" data-alt="{{ photo.alt }}" data-hash="{{ photo.hash }}" data-w="{{ photo.width }}" data-h="{{ photo.height }}" style="aspect-ratio: {{ photo.width }} / {{ photo.height }}" aria-label="{{ photo.label }}">
          <img src="{{ photo.sm }}" alt="{{ photo.alt }}" width="{{ photo.smWidth }}" height="{{ photo.smHeight }}" loading="lazy" decoding="async">
        </button>
      @endforeach
    </div>
  </div>
@endsection
