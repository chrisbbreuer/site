<script server>
const fs = require('node:fs')
const path = require('node:path')

const title = 'About - Chris Breuer'
const description = 'I\'m Chris Breuer, a software engineer passionately obsessed over developer tooling.'
const activeNav = 'about'
const pagePath = '/about'

// Photos: built by `bun scripts/build-gallery.ts` from my photo dump. All of
// them flow into one masonry that wraps around the bio and portrait — the
// layout is computed by /assets/scripts/gallery.js (aspect ratios are known
// up front, so there's no reflow on load).
const gallery = JSON.parse(fs.readFileSync(path.join(process.cwd(), 'content/gallery.json'), 'utf-8'))

const work = [
  { name: 'Stacks.js, Inc.', role: 'Founder', period: '2024 to present' },
  { name: 'Bixolon', role: 'Consultant', period: '2020 to 2024' },
  { name: 'University of Oregon', role: 'Consultant', period: '2020 to 2021' },
  { name: 'Girlgaze', role: 'Consultant', period: '2019 to 2020' },
]

const elsewhere = [
  { name: 'GitHub', url: 'https://github.com/chrisbbreuer', text: 'Code, most days.' },
  { name: 'Bluesky', url: 'https://bsky.app/profile/chrisbreuer.me', text: 'Shorter thoughts.' },
  { name: 'LinkedIn', url: 'https://www.linkedin.com/in/%F0%9F%8C%B1-chris-breuer-33231765/' },
  { name: 'Email', url: 'mailto:hi@chrisbreuer.me', text: 'hi@chrisbreuer.me' },
]
</script>

@layout('layouts/site')

@section('content')
  <div class="about-wrap">
    <div class="bio-col">
      <h1 class="page-title">Passionately obsessed over developer tooling.</h1>
      <div class="prose">
        <p>
          Ever since I was young, I've loved to explore, learn, and create, especially
          while using tech. When I was 12 years old, I wrote my first SaaS app, and to
          my surprise it turned out quite successful and brought in several hundred
          dollars monthly via Google AdSense.
        </p>
        <p>
          The only thing I loved more than computers as a kid was sports and the
          outdoors. Almost 20 years later, not much has changed: going on hikes with my
          dogs and playing soccer are still some of the few things that peel me away
          from my desk.
        </p>
        <p>
          I spent the last 15+ years working on personal and private projects, ranging
          from small apps to large enterprise services, which caused my obsession with
          building scalable systems. I dove deep into data storage and
          transfer, and distributed and decentralized compute techniques. That was a
          core reason I started working on Stacks.
        </p>
        <p>
          Today, I work on <a href="https://stacksjs.com">Stacks</a> and its broader ecosystem.
          It's exciting to work on the future of web technologies and application / software
          development. Follow along on <a href="https://github.com/chrisbbreuer">GitHub</a>
          for the latest updates.
        </p>
      </div>

      <h2 class="section-label">Work</h2>
      <ul class="entry-list">
        @foreach (work as job)
          <li>
            <span class="entry-name">{{ job.name }}</span>
            <span class="entry-desc">{{ job.role }} <span class="entry-meta">{{ job.period }}</span></span>
          </li>
        @endforeach
      </ul>

      <h2 class="section-label">Elsewhere</h2>
      <ul class="entry-list">
        @foreach (elsewhere as place)
          <li>
            <span class="entry-name"><a href="{{ place.url }}" rel="me">{{ place.name }}</a></span>
            <span class="entry-desc">{{ place.text }}</span>
          </li>
        @endforeach
      </ul>
    </div>

    <aside class="portrait-col">
      <img src="/images/chris.jpg" alt="Chris Breuer" width="480" height="480">
      <p class="portrait-note">Los Angeles based. Usually outside with the dogs when I'm not at the keyboard.</p>
    </aside>

    <div class="photo-masonry" aria-label="Photographs">
      @foreach (gallery as photo)
        <button type="button" class="gallery-item" data-full="{{ photo.lg }}" data-hash="{{ photo.hash }}" data-w="{{ photo.width }}" data-h="{{ photo.height }}" style="aspect-ratio: {{ photo.width }} / {{ photo.height }}" aria-label="Open photograph">
          <img src="{{ photo.sm }}" alt="" width="{{ photo.smWidth }}" height="{{ photo.smHeight }}" loading="lazy" decoding="async">
        </button>
      @endforeach
    </div>
  </div>
@endsection
