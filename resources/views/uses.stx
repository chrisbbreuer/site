<script server>
const sections = [
  {
    title: 'Workstation',
    tools: [
      { name: '14" MacBook M3 Pro', text: 'I was using an Intel-based MacBook Pro before this and the difference was stunning. These days a MacBook Air on Apple Silicon is more than powerful enough for the latest dev tooling, and that\'s great.' },
      { name: 'Apple Studio Display', text: 'Coming from LG\'s 27" UltraFine 5K IPS monitor, I have enjoyed the transition to the Apple Studio Display.' },
      { name: 'MX Keys for Mac', text: 'Love the travel time of this keyboard. Feels similar to the MacBooks, but with a little more travel. Designed to work seamlessly with Macs and iPads.' },
      { name: 'MX Master 3S', text: 'I used the MX Master 3 for years and it was always great. The 3S feels similar with a few minor improvements, like the clicks. The scroll wheel is great as always.' },
    ],
  },
  {
    title: 'Development',
    tools: [
      { name: 'Ghostty', text: 'A fast, feature-rich, cross-platform terminal emulator that uses platform-native UI and GPU acceleration.' },
      { name: 'Stacks', text: 'The Stacks Dashboard app is key to my productivity. It supercharges my local development experience and automates management of all my resources.' },
      { name: 'VS Code & Cursor', text: 'VS Code is an amazing code editor. Cursor is great for some AI tasks.' },
      { name: 'TablePlus', text: 'Over the years I have used many database tools, and TablePlus is the one that stuck. Great tool for working with databases.' },
      { name: 'GitHub Desktop', text: 'My trusty sidekick for most git needs. No shame.' },
    ],
  },
  {
    title: 'Design',
    tools: [
      { name: 'Figma', text: 'We started using Figma as just a design tool, but it has become our virtual whiteboard for everything.' },
    ],
  },
  {
    title: 'Productivity',
    tools: [
      { name: 'Raycast', text: 'Makes it simple, fast, and delightful to control my tools. I love assigning custom keyboard shortcuts to anything I use frequently.' },
      { name: '1Password', text: 'Go-to password manager.' },
      { name: 'SavvyCal', text: 'Great tool for scheduling meetings while protecting my calendar.' },
      { name: 'Muzzle', text: 'Automatically blocks incoming notifications when I\'m in meetings.' },
    ],
  },
]
</script>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Uses - Chris Breuer</title>
  <meta name="description" content="Software Chris Breuer uses, gadgets he loves, and other things he recommends.">
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
