      </nav>
    </header>

    <main>
      <h1 class="page-title">Software I use, gadgets I love.</h1>
      <p class="page-lead">
        I get asked a lot about the things I use to build software, stay productive, or buy
        to fool myself into thinking I'm being productive when I'm really just
        procrastinating. Here's the list.
      </p>

      @foreach (sections as section)
        <h2 class="section-label">{{ section.title }}</h2>
        <ul class="entry-list">
          @foreach (section.tools as tool)
            <li>
              <span class="entry-name">{{ tool.name }}</span>
              <span class="entry-desc">{{ tool.text }}</span>
            </li>
          @endforeach
        </ul>
      @endforeach
    </main>

    <footer class="site-footer">
