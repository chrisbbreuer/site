</head>
<body>
  <div class="shell">
    <header class="masthead">
      <a class="brand" href="/">
        <img src="/images/avatar.png" alt="Chris Breuer" width="28" height="28">
        chris breuer
      </a>
      <nav aria-label="Site">
        <a href="/blog">Blog</a>
