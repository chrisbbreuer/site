<script server>
const fs = require('node:fs')
const path = require('node:path')

const title = 'WIP - Chris Breuer'
const description = 'A progress page for both halves: fitness from HQ.training and work from GitHub, one square a day for the last year.'
const activeNav = 'wip'
const pagePath = '/wip'

// --- HQ.training --------------------------------------------------------------
//
// The <hq-activity-chart> web component, the embed HQ.training gives every
// athlete. site.js loads its script from `api` when the element is on the
// page. The token comes from the environment rather than this file so a new
// one (HQ.training > Profile > Fitness activity > Embed) is a config change.
const hqApi = String(process.env.HQ_ACTIVITY_API || 'https://hq.training').replace(/\/$/, '')
const hqToken = String(process.env.HQ_ACTIVITY_TOKEN || '')

// Where both charts put their year list: 'top' (a row of tabs above the
// chart, so the page stays as narrow as the graphs) or 'side' (GitHub's own
// layout, a column beside it). One setting for both, so they always match.
const yearsPosition = 'top'

// --- GitHub -------------------------------------------------------------------
//
// content/github-contributions.json is regenerated by
// `bun scripts/fetch-contributions.ts`. It holds every year; the page draws
// one, picked by `?year=` like GitHub's own year links, and GitHub's
// markup: a table with 3px border-spacing, 10px days and a 28px weekday
// column, measured off github.com.
const github = JSON.parse(fs.readFileSync(path.join(process.cwd(), 'content/github-contributions.json'), 'utf-8'))
const requestedYear = typeof query === 'object' && query ? String(query.year || '') : ''
const ghKey = github.calendars[requestedYear] ? requestedYear : 'last'
const ghCalendar = github.calendars[ghKey]
const ghToday = new Date().toISOString().slice(0, 10)

const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December']
const WEEKDAYS = [['Sunday', ''], ['Monday', 'Mon'], ['Tuesday', ''], ['Wednesday', 'Wed'], ['Thursday', ''], ['Friday', 'Fri'], ['Saturday', '']]
// Days this close to either end pin their tooltip to that end.
const EDGE_WEEKS = 14

function ordinal(n) {
  const tens = n % 100
  if (tens >= 11 && tens <= 13) return `${n}th`
  return `${n}${['th', 'st', 'nd', 'rd'][n % 10] || 'th'}`
}

const ghColumns = ghCalendar.weeks.length
const ghRows = WEEKDAYS.map(([name, short], row) => ({ name, short, row, days: Array.from({ length: ghColumns }, () => null) }))
ghCalendar.weeks.forEach((week, column) => {
  for (const [date, count, level] of week) {
    // A calendar year's first week starts on whatever day 1 January is.
    const row = new Date(`${date}T00:00:00Z`).getUTCDay()
    if (date > ghToday) continue
    const when = `${MONTHS[Number(date.slice(5, 7)) - 1]} ${ordinal(Number(date.slice(8, 10)))}`
    ghRows[row].days[column] = {
      date,
      level,
      tip: `${count ? count.toLocaleString('en-US') : 'No'} contribution${count === 1 ? '' : 's'} on ${when}.`,
      edge: column < EDGE_WEEKS ? 'start' : column >= ghColumns - EDGE_WEEKS ? 'end' : '',
      below: row < 3,
    }
  }
})

// GitHub labels the column a month starts in.
const ghMonths = ghCalendar.weeks.map((week) => {
  const first = week.find(([date]) => date.endsWith('-01'))
  return first ? MONTHS[Number(first[0].slice(5, 7)) - 1].slice(0, 3) : ''
})

const ghHeading = `${ghCalendar.total.toLocaleString('en-US')} contribution${ghCalendar.total === 1 ? '' : 's'} in ${ghKey === 'last' ? 'the last year' : ghKey}`
// As on GitHub, the newest year stands for "the last year".
const ghYears = github.years.map((year, index) => ({
  year,
  href: index === 0 ? '/wip' : `/wip?year=${year}`,
  current: ghKey === 'last' ? index === 0 : String(year) === ghKey,
}))
</script>

@layout('layouts/site')

@section('content')
  <h1 class="page-title">WIP.</h1>
  <p class="page-lead">
    Me, as a work in progress. This page tracks both halves the same way: one
    square a day for the last year, darker the more that day held. Fitness is
    everything I train, from <a href="https://hq.training">HQ.training</a>.
    Work is everything I ship, from <a href="https://github.com/chrisbbreuer">GitHub</a>.
    Gaps show, which is the point.
  </p>

  <h2 class="section-label">Fitness</h2>
  <div class="wip-graph">
    @if (hqToken)
      <hq-activity-chart token="{{ hqToken }}" api="{{ hqApi }}" years="{{ yearsPosition }}"></hq-activity-chart>
    @else
      <p class="empty-note">
        The fitness chart is not connected yet. It will be back shortly.
      </p>
    @endif
  </div>

  <h2 class="section-label">Work</h2>
  <div class="gh-contrib wip-graph gh-contrib--years-{{ yearsPosition }}">
    <div class="gh-main">
      <h3 class="gh-heading">{{ ghHeading }}</h3>
      <div class="gh-box">
        <div class="gh-scroll"><div class="gh-canvas">
          <table class="gh-grid" role="grid" aria-readonly="true">
            <caption class="sr-only">Contribution Graph</caption>
            <thead>
              <tr>
                <td class="gh-label-col"><span class="sr-only">Day of Week</span></td>
                @foreach (ghMonths as month)
                  <td class="gh-month"><span aria-hidden="true">{{ month }}</span></td>
                @endforeach
              </tr>
            </thead>
            <tbody>
              @foreach (ghRows as row)
                <tr>
                  <td class="gh-label-col"><span class="sr-only">{{ row.name }}</span><span class="gh-weekday" aria-hidden="true">{{ row.short }}</span></td>
                  @foreach (row.days as day)
                    @if (day)
                      <td class="gh-day" data-level="{{ day.level }}" data-date="{{ day.date }}" data-tip="{{ day.tip }}" data-edge="{{ day.edge }}"@if (day.below) data-below@endif aria-label="{{ day.tip }}"></td>
                    @else
                      <td></td>
                    @endif
                  @endforeach
                </tr>
              @endforeach
            </tbody>
          </table>
        <div class="gh-footer">
          <a href="https://docs.github.com/articles/why-are-my-contributions-not-showing-up-on-my-profile">Learn how we count contributions</a>
          <span class="gh-legend" aria-hidden="true">Less <i class="gh-day" data-level="0"></i><i class="gh-day" data-level="1"></i><i class="gh-day" data-level="2"></i><i class="gh-day" data-level="3"></i><i class="gh-day" data-level="4"></i> More</span>
        </div>
        </div></div>
      </div>
    </div>
    <!-- Year links load the page in full (data-no-router): the SPA router
         drops the query string when it stays on /wip. -->
    <ul class="gh-years" aria-label="Contribution year">
      @foreach (ghYears as item)
        <li><a href="{{ item.href }}" data-no-router@if (item.current) aria-current="true"@endif>{{ item.year }}</a></li>
      @endforeach
    </ul>
  </div>
@endsection
